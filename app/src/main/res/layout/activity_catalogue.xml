<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF2F8">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Notre Catalogue"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A5276"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Produit 1 -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/chaussures"
                android:scaleType="centerInside"
                android:contentDescription="Chaussures" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produit 1 : Chaussures"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProduit1"
                android:text="Acheter"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Produit 2 -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/accessoires"
                android:scaleType="centerInside"
                android:contentDescription="Accessoires" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produit 2 : Accessoires"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProduit2"
                android:text="Acheter"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Produit 3 -->
        <LinearLayout
            android:orientation="vertical"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/cosmetiques"
                android:scaleType="centerInside"
                android:contentDescription="Cosmétiques" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Produit 3 : Cosmétiques"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProduit3"
                android:text="Acheter"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
